{%- comment -%}
  Petite Mort — SHIPPING UPDATE
  Direction A (Warm Editorial). Settings → Notifications → Shipping update.
  Fires when tracking info changes on an existing fulfillment.

  DELIBERATE OMISSIONS vs the design preview — Shopify's notification scope exposes
  NO previous delivery estimate and NO carrier delay reason, so the struck-through
  "previously…" line and the "Reason: sorting-centre delay" line cannot be populated
  from real data. They are dropped rather than left to render blank. To restore them
  you need Shopify Flow writing an order metafield; see INSTALL-RUNBOOK.md.
{%- endcomment -%}

{%- assign lead_min = 3 -%}
{%- assign lead_max = 6 -%}
{%- assign dest = shipping_address.country_code | default: 'XX' -%}
{%- case dest -%}
  {%- when 'NL' -%}{%- assign lead_min = 1 -%}{%- assign lead_max = 2 -%}
  {%- when 'BE' -%}{%- assign lead_min = 1 -%}{%- assign lead_max = 2 -%}
  {%- when 'DE' -%}{%- assign lead_min = 2 -%}{%- assign lead_max = 3 -%}
  {%- when 'SE' -%}{%- assign lead_min = 2 -%}{%- assign lead_max = 4 -%}
  {%- when 'DK' -%}{%- assign lead_min = 2 -%}{%- assign lead_max = 4 -%}
  {%- when 'IE' -%}{%- assign lead_min = 2 -%}{%- assign lead_max = 4 -%}
  {%- when 'PL' -%}{%- assign lead_min = 2 -%}{%- assign lead_max = 4 -%}
  {%- when 'FI' -%}{%- assign lead_min = 3 -%}{%- assign lead_max = 5 -%}
{%- endcase -%}
{%- assign claim_days = lead_max | plus: 3 -%}
{%- assign secs_min = lead_min | times: 86400 -%}
{%- assign secs_max = lead_max | times: 86400 -%}
{%- assign secs_claim = claim_days | times: 86400 -%}
{%- comment -%} fulfillment.updated_at does not exist; anchoring a REVISED window to the
  original despatch would under-state it. Sent at the moment tracking changes, so 'now'. {%- endcomment -%}
{%- assign base_ts = 'now' | date: '%s' -%}
{%- assign ts_from = base_ts | plus: secs_min -%}
{%- assign ts_to = base_ts | plus: secs_max -%}
{%- comment -%} Push a weekend endpoint to the Monday. None of these markets get Saturday
  or Sunday delivery, and printing a weekend date is how a promise becomes a ticket.
  %w is 0=Sunday .. 6=Saturday; times:1 forces the string to an integer for comparison. {%- endcomment -%}
{%- assign dow = ts_from | date: '%w' | times: 1 -%}
{%- if dow == 6 -%}{%- assign ts_from = ts_from | plus: 172800 -%}{%- elsif dow == 0 -%}{%- assign ts_from = ts_from | plus: 86400 -%}{%- endif -%}
{%- assign dow = ts_to | date: '%w' | times: 1 -%}
{%- if dow == 6 -%}{%- assign ts_to = ts_to | plus: 172800 -%}{%- elsif dow == 0 -%}{%- assign ts_to = ts_to | plus: 86400 -%}{%- endif -%}
{%- if ts_to < ts_from -%}{%- assign ts_to = ts_from -%}{%- endif -%}
{%- assign day_from = ts_from | date: '%Y%m%d' -%}
{%- assign day_to = ts_to | date: '%Y%m%d' -%}
{%- if day_from == day_to -%}
{%- assign eta_window = ts_to | date: '%a %-d %B' -%}
{%- else -%}
{%- assign part_from = ts_from | date: '%a %-d' -%}
{%- assign part_to = ts_to | date: '%a %-d %B' -%}
{%- assign eta_window = part_from | append: ' – ' | append: part_to -%}
{%- endif -%}
{%- assign ts_claim = base_ts | plus: secs_claim -%}
{%- assign dow = ts_claim | date: '%w' | times: 1 -%}
{%- if dow == 6 -%}{%- assign ts_claim = ts_claim | plus: 172800 -%}{%- elsif dow == 0 -%}{%- assign ts_claim = ts_claim | plus: 86400 -%}{%- endif -%}
{%- assign claim_by = ts_claim | date: '%a %-d %B' -%}
{%- assign buyer = customer.first_name | default: shipping_address.first_name -%}
{%- assign track_url = fulfillment.tracking_url | default: order_status_url -%}

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ shop.name }} — An update on order {{ order_name }}</title>
</head>
<body style="margin:0;padding:0;background:#efeae6;">

<div style="display:none;max-height:0;overflow:hidden;opacity:0;">Order {{ order_name }} is now arriving {{ eta_window }}. Nothing needed from you.</div>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#efeae6;">
<tr><td align="center" style="padding:28px 12px 44px;">

<table role="presentation" width="600" cellpadding="0" cellspacing="0" style="width:600px;max-width:100%;background:#ffffff;border-radius:16px;overflow:hidden;font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;">

  <tr><td style="padding:34px 40px 0;" align="center">
    <img src="https://petitemort.co/cdn/shop/files/PM_Logo1_Black_1.png" width="132" alt="{{ shop.name }}" style="display:block;border:0;width:132px;height:auto;">
  </td></tr>

  <tr><td style="padding:26px 40px 0;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
      <tr>
        <td style="font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#8a8a8a;">Order {{ order_name }}</td>
        <td align="right" style="font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#8a8a8a;">Updated {{ base_ts | date: '%-d %B' }}</td>
      </tr>
    </table>
  </td></tr>

  <tr><td style="padding:30px 40px 0;">
    <h1 style="margin:0;font-size:30px;line-height:1.2;font-weight:600;color:#2c2d2e;letter-spacing:-.02em;">An update on your parcel{% if buyer %}, {{ buyer }}{% endif %}.</h1>
    <p style="margin:14px 0 0;font-size:15px;line-height:1.65;color:#57585a;">
      We&rsquo;d rather tell you than let you keep checking. The carrier has revised your
      delivery window &mdash; the parcel is safe and still moving.
    </p>
  </td></tr>

  <tr><td style="padding:26px 40px 0;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f3d6cd;border-radius:14px;">
      <tr><td style="padding:22px 24px;border-left:4px solid #b8543d;border-radius:14px;">
        <div style="font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#b8543d;font-weight:600;">New arrival window</div>
        <div style="margin-top:7px;font-size:22px;font-weight:600;color:#2c2d2e;letter-spacing:-.01em;">{{ eta_window }}</div>
        <div style="margin-top:10px;font-size:13.5px;line-height:1.6;color:#7a5348;">
          No action needed from you &mdash; tracking will keep updating on its own.
        </div>
      </td></tr>
    </table>
  </td></tr>

  <tr><td style="padding:30px 40px 0;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
      <tr>
        <td width="25%" align="center" style="padding-bottom:9px;"><div style="width:11px;height:11px;border-radius:50%;background:#b8543d;margin:0 auto;"></div></td>
        <td width="25%" align="center" style="padding-bottom:9px;"><div style="width:11px;height:11px;border-radius:50%;background:#b8543d;margin:0 auto;"></div></td>
        <td width="25%" align="center" style="padding-bottom:9px;"><div style="width:15px;height:15px;border-radius:50%;background:#b8543d;border:3px solid #f3d6cd;margin:0 auto;"></div></td>
        <td width="25%" align="center" style="padding-bottom:9px;"><div style="width:11px;height:11px;border-radius:50%;background:#e0d5d0;margin:0 auto;"></div></td>
      </tr>
      <tr><td colspan="4" style="padding:0 12%;"><div style="height:2px;background:#e8e0dc;font-size:0;line-height:0;">&nbsp;</div></td></tr>
      <tr>
        <td align="center" style="padding-top:11px;font-size:11.5px;color:#a3a3a3;">Confirmed</td>
        <td align="center" style="padding-top:11px;font-size:11.5px;color:#a3a3a3;">Packed</td>
        <td align="center" style="padding-top:11px;font-size:11.5px;font-weight:600;color:#b8543d;">In transit</td>
        <td align="center" style="padding-top:11px;font-size:11.5px;color:#a3a3a3;">Delivered</td>
      </tr>
    </table>
  </td></tr>

  <tr><td style="padding:28px 40px 0;" align="center">
    <table role="presentation" cellpadding="0" cellspacing="0"><tr>
      <td style="background:#2c2d2e;border-radius:25px;">
        <a href="{{ track_url }}" style="display:inline-block;padding:15px 40px;font-size:14.5px;font-weight:600;color:#ffffff;text-decoration:none;letter-spacing:.01em;">See live tracking</a>
      </td>
    </tr></table>
    {%- if fulfillment.tracking_company or fulfillment.tracking_number -%}
    <div style="margin-top:13px;font-size:13px;color:#8a8a8a;">{{ fulfillment.tracking_company }}{% if fulfillment.tracking_company and fulfillment.tracking_number %} &nbsp;·&nbsp; {% endif %}{{ fulfillment.tracking_number }}</div>
    {%- endif -%}
  </td></tr>

  <tr><td style="padding:30px 40px 0;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#faf7f5;border-radius:12px;">
      <tr><td style="padding:18px 20px;">
        <div style="font-size:13px;font-weight:600;color:#2c2d2e;">If it hasn&rsquo;t arrived by {{ claim_by }}</div>
        <div style="margin-top:6px;font-size:13px;line-height:1.6;color:#7c7c7c;">
          We open a claim with the carrier and send you a replacement or a full refund &mdash;
          your choice, no need to chase us. We watch this ourselves.
        </div>
      </td></tr>
    </table>
  </td></tr>

  <tr><td style="padding:32px 40px 0;">
    <div style="height:1px;background:#ebe6e3;font-size:0;">&nbsp;</div>
    <div style="margin-top:24px;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#8a8a8a;font-weight:600;">Questions we usually get</div>

    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-top:16px;">
      <tr><td style="padding-bottom:15px;">
        <div style="font-size:13.5px;font-weight:600;color:#2c2d2e;">Do I need to do anything?</div>
        <div style="margin-top:4px;font-size:13px;line-height:1.6;color:#7c7c7c;">No. The parcel is with the carrier and will move on its own. This email is just so the new date comes from us rather than a tracking page.</div>
      </td></tr>
      <tr><td style="padding-bottom:15px;">
        <div style="font-size:13.5px;font-weight:600;color:#2c2d2e;">Can I cancel and get my money back?</div>
        <div style="margin-top:4px;font-size:13px;line-height:1.6;color:#7c7c7c;">Yes. Reply to this email and we&rsquo;ll refund you in full, even if the parcel is already in transit. You don&rsquo;t have to wait for it to arrive first.</div>
      </td></tr>
      <tr><td>
        <div style="font-size:13.5px;font-weight:600;color:#2c2d2e;">Will the delivery window change again?</div>
        <div style="margin-top:4px;font-size:13px;line-height:1.6;color:#7c7c7c;">It can, and if it does you&rsquo;ll get another email like this one. We don&rsquo;t quietly move dates.</div>
      </td></tr>
    </table>
  </td></tr>

  <tr><td style="padding:26px 40px 0;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#2c2d2e;border-radius:14px;">
      <tr><td style="padding:24px 26px;">
        <div style="font-size:15px;font-weight:600;color:#ffffff;">Talk to a person</div>
        <div style="margin-top:7px;font-size:13.5px;line-height:1.65;color:#b9bbbd;">
          Reply to this email or write to <a href="mailto:info@petitemort.co" style="color:#f3d6cd;text-decoration:underline;">info@petitemort.co</a>.<br>
          We answer within one working day, Monday to Friday.
        </div>
      </td></tr>
    </table>
  </td></tr>

  <tr><td style="padding:30px 40px 38px;" align="center">
    <div style="font-size:12.5px;line-height:1.7;color:#9a9a9a;">
      <a href="{{ shop.url }}/policies/shipping-policy" style="color:#7c7c7c;text-decoration:none;">Shipping</a> &nbsp;·&nbsp;
      <a href="{{ shop.url }}/policies/refund-policy" style="color:#7c7c7c;text-decoration:none;">Returns</a> &nbsp;·&nbsp;
      <a href="{{ shop.url }}/pages/contact" style="color:#7c7c7c;text-decoration:none;">Contact</a> &nbsp;·&nbsp;
      <a href="{{ track_url }}" style="color:#7c7c7c;text-decoration:none;">Track order</a>
    </div>
    <div style="margin-top:16px;font-size:11.5px;line-height:1.7;color:#b4b4b4;">
      {{ shop.name }} &nbsp;·&nbsp; Instraat 13, 6021 AC Budel, Netherlands<br>
      This is a delivery update for order {{ order_name }}.
    </div>
  </td></tr>

</table>
</td></tr>
</table>
</body>
</html>
