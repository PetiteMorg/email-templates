{%- comment -%}
  Petite Mort — ORDER CANCELLED
  Direction A (Warm Editorial). Settings → Notifications → Order cancelled.

  A cancellation may or may not carry a refund (an unpaid/pending order has nothing to
  return). The money panel is therefore conditional on a real refund transaction, and
  the copy changes when there is none. Do not unwrap that condition.
{%- endcomment -%}

{%- assign buyer = customer.first_name | default: billing_address.first_name | default: shipping_address.first_name -%}
{%- assign cancel_ts = cancelled_at | default: created_at -%}
{%- assign refund_total = 0 -%}
{%- assign refund_gateway = '' -%}
{%- assign refund_last4 = '' -%}
{%- for transaction in transactions -%}
  {%- if transaction.kind == 'refund' and transaction.status == 'success' -%}
    {%- assign refund_total = refund_total | plus: transaction.amount -%}
    {%- if transaction.payment_details.credit_card_company -%}
      {%- assign refund_gateway = transaction.payment_details.credit_card_company -%}
      {%- assign refund_last4 = transaction.payment_details.credit_card_last_four_digits -%}
    {%- else -%}
      {%- assign refund_gateway = transaction.gateway_display_name | default: transaction.gateway -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}
{%- assign has_refund = false -%}
{%- if refund_total > 0 -%}{%- assign has_refund = true -%}{%- endif -%}
{%- assign land_by = cancel_ts | date: '%s' | plus: 432000 | date: '%-d %B %Y' -%}
{%- assign chase_after = cancel_ts | date: '%s' | plus: 604800 | date: '%-d %B' -%}

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ shop_name }} — Order {{ order_name }} cancelled</title>
</head>
<body style="margin:0;padding:0;background:#efeae6;">

<div style="display:none;max-height:0;overflow:hidden;opacity:0;">Order {{ order_name }} is cancelled.{% if has_refund %} {{ refund_total | money }} goes back to {{ refund_gateway }} within 3–5 working days.{% endif %}</div>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#efeae6;">
<tr><td align="center" style="padding:28px 12px 44px;">

<table role="presentation" width="600" cellpadding="0" cellspacing="0" style="width:600px;max-width:100%;background:#ffffff;border-radius:16px;overflow:hidden;font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;">

  <tr><td style="padding:34px 40px 0;" align="center">
    <img src="https://petitemort.co/cdn/shop/files/PM_Logo1_Black_1.png" width="132" alt="{{ shop_name }}" style="display:block;border:0;width:132px;height:auto;">
  </td></tr>

  <tr><td style="padding:26px 40px 0;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
      <tr>
        <td style="font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#8a8a8a;">Order {{ order_name }}</td>
        <td align="right" style="font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#8a8a8a;">Cancelled {{ cancel_ts | date: '%-d %B' }}</td>
      </tr>
    </table>
  </td></tr>

  <tr><td style="padding:30px 40px 0;">
    <h1 style="margin:0;font-size:30px;line-height:1.2;font-weight:600;color:#2c2d2e;letter-spacing:-.02em;">Your order is cancelled.</h1>
    <p style="margin:14px 0 0;font-size:15px;line-height:1.65;color:#57585a;">
      {% if buyer %}{{ buyer }}, nothing{% else %}Nothing{% endif %} has shipped.
      {% if has_refund %}Your money is already on its way back &mdash; the detail is below so you
      know exactly what to expect.{% else %}You have not been charged, so there is nothing to
      refund and nothing further to do.{% endif %}
    </p>
  </td></tr>

  {%- if has_refund -%}
  <tr><td style="padding:26px 40px 0;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f6f2f0;border-radius:14px;">
      <tr><td style="padding:22px 24px;border-left:4px solid #b4b4b4;border-radius:14px;">
        <div style="font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#8a8a8a;font-weight:600;">Going back to you</div>
        <div style="margin-top:7px;font-size:26px;font-weight:600;color:#b8543d;letter-spacing:-.01em;">{{ refund_total | money }}</div>
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-top:14px;">
          <tr>
            <td style="font-size:13px;color:#8a8a8a;padding-bottom:7px;">Back to</td>
            <td align="right" style="font-size:13px;font-weight:600;color:#2c2d2e;padding-bottom:7px;">{{ refund_gateway }}{% if refund_last4 != '' %} &nbsp;·&nbsp; &bull;&bull;&bull;&bull; {{ refund_last4 }}{% endif %}</td>
          </tr>
          <tr>
            <td style="font-size:13px;color:#8a8a8a;padding-bottom:7px;">Issued</td>
            <td align="right" style="font-size:13px;font-weight:600;color:#2c2d2e;padding-bottom:7px;">{{ cancel_ts | date: '%-d %B %Y' }}</td>
          </tr>
          <tr>
            <td style="font-size:13px;color:#8a8a8a;">In your account by</td>
            <td align="right" style="font-size:13px;font-weight:600;color:#2c2d2e;">{{ land_by }}</td>
          </tr>
        </table>
        <div style="margin-top:14px;font-size:13px;line-height:1.6;color:#7c7c7c;">
          That is 3&ndash;5 working days, which is your bank&rsquo;s processing time, not ours &mdash;
          we released it the moment the order was cancelled.
        </div>
      </td></tr>
    </table>
  </td></tr>

  <tr><td style="padding:30px 40px 0;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
      <tr>
        <td width="50%" align="center" style="padding-bottom:9px;"><div style="width:11px;height:11px;border-radius:50%;background:#b8543d;margin:0 auto;"></div></td>
        <td width="50%" align="center" style="padding-bottom:9px;"><div style="width:11px;height:11px;border-radius:50%;background:#e0d5d0;margin:0 auto;"></div></td>
      </tr>
      <tr><td colspan="2" style="padding:0 25%;"><div style="height:2px;background:#e8e0dc;font-size:0;line-height:0;">&nbsp;</div></td></tr>
      <tr>
        <td align="center" style="padding-top:11px;font-size:11.5px;font-weight:600;color:#b8543d;">Refund issued</td>
        <td align="center" style="padding-top:11px;font-size:11.5px;color:#a3a3a3;">In your account</td>
      </tr>
    </table>
  </td></tr>
  {%- endif -%}

  <tr><td style="padding:32px 40px 0;"><div style="height:1px;background:#ebe6e3;font-size:0;">&nbsp;</div></td></tr>

  <tr><td style="padding:26px 40px 0;">
    <div style="font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#8a8a8a;font-weight:600;">Cancelled items</div>
  </td></tr>

  {%- for line in line_items -%}
  <tr><td style="padding:18px 40px 0;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
      <tr>
        <td width="62" valign="top">
          {%- if line.image -%}
          <img src="{{ line | img_url: 'compact' }}" width="62" alt="{{ line.title | escape }}" style="display:block;border:1px solid #ede7e4;border-radius:10px;width:62px;height:auto;">
          {%- else -%}
          <div style="width:62px;height:62px;border-radius:10px;background:#f6f2f0;border:1px solid #ede7e4;"></div>
          {%- endif -%}
        </td>
        <td valign="top" style="padding-left:16px;">
          <div style="font-size:14.5px;font-weight:600;color:#2c2d2e;">{{ line.product.title | default: line.title }}</div>
          <div style="margin-top:3px;font-size:12.5px;color:#8a8a8a;">
            {%- if line.variant.title and line.variant.title != 'Default Title' -%}{{ line.variant.title }} &nbsp;·&nbsp; {%- endif -%}
            Qty {{ line.quantity }}
          </div>
        </td>
        <td align="right" valign="top" style="font-size:14.5px;color:#8a8a8a;white-space:nowrap;">{{ line.final_line_price | money }}</td>
      </tr>
    </table>
  </td></tr>
  {%- endfor -%}

  <tr><td style="padding:20px 40px 0;">
    <div style="height:1px;background:#ebe6e3;font-size:0;">&nbsp;</div>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-top:16px;">
      {%- if cancel_reason -%}
      <tr><td style="font-size:13.5px;color:#6f6f6f;padding-bottom:9px;">Reason</td><td align="right" style="font-size:13.5px;color:#2c2d2e;padding-bottom:9px;">{{ cancel_reason_label | default: cancel_reason }}</td></tr>
      {%- endif -%}
      <tr>
        <td style="font-size:15px;font-weight:600;color:#2c2d2e;">{% if has_refund %}Total refunded{% else %}Order total{% endif %}</td>
        <td align="right" style="font-size:15px;font-weight:600;color:#2c2d2e;">{% if has_refund %}{{ refund_total | money }}{% else %}{{ total_price | money }}{% endif %}</td>
      </tr>
    </table>
  </td></tr>

  <tr><td style="padding:28px 40px 0;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#faf7f5;border-radius:12px;">
      <tr><td style="padding:20px 22px;">
        <div style="font-size:14px;font-weight:600;color:#2c2d2e;">Cancelled by mistake?</div>
        <div style="margin-top:6px;font-size:13px;line-height:1.6;color:#7c7c7c;">
          We can&rsquo;t reinstate a cancelled order, but placing it again takes a minute and
          your original discount still applies &mdash; reply and we&rsquo;ll reissue the code.
        </div>
        <div style="margin-top:14px;">
          <table role="presentation" cellpadding="0" cellspacing="0"><tr>
            <td style="background:#2c2d2e;border-radius:25px;">
              <a href="{{ shop.url }}" style="display:inline-block;padding:13px 30px;font-size:13.5px;font-weight:600;color:#ffffff;text-decoration:none;">Order it again</a>
            </td>
          </tr></table>
        </div>
      </td></tr>
    </table>
  </td></tr>

  <tr><td style="padding:32px 40px 0;">
    <div style="height:1px;background:#ebe6e3;font-size:0;">&nbsp;</div>
    <div style="margin-top:24px;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#8a8a8a;font-weight:600;">Questions we usually get</div>

    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-top:16px;">
      {%- if has_refund -%}
      <tr><td style="padding-bottom:15px;">
        <div style="font-size:13.5px;font-weight:600;color:#2c2d2e;">I can&rsquo;t see the money yet.</div>
        <div style="margin-top:4px;font-size:13px;line-height:1.6;color:#7c7c7c;">Give it the full five working days first &mdash; banks post refunds in batches. If it&rsquo;s still missing after {{ chase_after }}, reply and we&rsquo;ll send you the refund reference to give your bank.</div>
      </td></tr>
      <tr><td style="padding-bottom:15px;">
        <div style="font-size:13.5px;font-weight:600;color:#2c2d2e;">Will it come back to a different card?</div>
        <div style="margin-top:4px;font-size:13px;line-height:1.6;color:#7c7c7c;">No. A refund can only go back the way it came, to the account used at checkout. We can&rsquo;t redirect it, even if you ask.</div>
      </td></tr>
      <tr><td style="padding-bottom:15px;">
        <div style="font-size:13.5px;font-weight:600;color:#2c2d2e;">What if my card has since expired or closed?</div>
        <div style="margin-top:4px;font-size:13px;line-height:1.6;color:#7c7c7c;">The refund still lands &mdash; banks route it to the replacement account. It can take a few days longer. Reply if nothing shows after ten working days.</div>
      </td></tr>
      {%- endif -%}
      <tr><td>
        <div style="font-size:13.5px;font-weight:600;color:#2c2d2e;">Do I need to send anything back?</div>
        <div style="margin-top:4px;font-size:13px;line-height:1.6;color:#7c7c7c;">No. This order never left our warehouse, so there is nothing to return.</div>
      </td></tr>
    </table>
  </td></tr>

  <tr><td style="padding:26px 40px 0;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#2c2d2e;border-radius:14px;">
      <tr><td style="padding:24px 26px;">
        <div style="font-size:15px;font-weight:600;color:#ffffff;">Talk to us before your bank</div>
        <div style="margin-top:7px;font-size:13.5px;line-height:1.65;color:#b9bbbd;">
          If anything about this cancellation looks wrong, reply to this email or write to
          <a href="mailto:info@petitemort.co" style="color:#f3d6cd;text-decoration:underline;">info@petitemort.co</a> &mdash;
          we fix it faster than a card dispute can, usually the same working day.
        </div>
      </td></tr>
    </table>
  </td></tr>

  <tr><td style="padding:30px 40px 38px;" align="center">
    <div style="font-size:12.5px;line-height:1.7;color:#9a9a9a;">
      <a href="{{ shop.url }}/policies/refund-policy" style="color:#7c7c7c;text-decoration:none;">Refunds</a> &nbsp;·&nbsp;
      <a href="{{ shop.url }}/policies/shipping-policy" style="color:#7c7c7c;text-decoration:none;">Shipping</a> &nbsp;·&nbsp;
      <a href="{{ shop.url }}/pages/contact" style="color:#7c7c7c;text-decoration:none;">Contact</a> &nbsp;·&nbsp;
      <a href="{{ shop.url }}" style="color:#7c7c7c;text-decoration:none;">Shop</a>
    </div>
    <div style="margin-top:16px;font-size:11.5px;line-height:1.7;color:#b4b4b4;">
      {{ shop_name }} &nbsp;·&nbsp; Instraat 13, 6021 AC Budel, Netherlands<br>
      This is a cancellation notice for order {{ order_name }}.
    </div>
  </td></tr>

</table>
</td></tr>
</table>
</body>
</html>
