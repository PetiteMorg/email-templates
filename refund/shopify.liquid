{%- comment -%}
  Petite Mort — REFUND NOTIFICATION
  Direction A (Warm Editorial). Settings → Notifications → Refund notification.

  `amount` is the refund total for THIS refund event, not the order total. An order can
  be refunded several times, so this email must never imply the whole order came back
  unless amount == total_price. That is what the partial block below tests for.
{%- endcomment -%}

{%- assign buyer = customer.first_name | default: billing_address.first_name | default: shipping_address.first_name -%}
{%- assign refund_gateway = '' -%}
{%- assign refund_last4 = '' -%}
{%- for transaction in transactions -%}
  {%- if transaction.kind == 'refund' -%}
    {%- if transaction.payment_details.credit_card_company -%}
      {%- assign refund_gateway = transaction.payment_details.credit_card_company -%}
      {%- assign refund_last4 = transaction.payment_details.credit_card_last_four_digits -%}
    {%- else -%}
      {%- assign refund_gateway = transaction.gateway_display_name | default: transaction.gateway -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}
{%- assign is_partial = false -%}
{%- if amount and total_price and amount < total_price -%}{%- assign is_partial = true -%}{%- endif -%}
{%- assign still_paid = total_price | minus: amount -%}
{%- assign land_by = 'now' | date: '%s' | plus: 432000 | date: '%-d %B %Y' -%}
{%- assign chase_after = 'now' | date: '%s' | plus: 604800 | date: '%-d %B' -%}

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ shop_name }} — Refund for order {{ order_name }}</title>
</head>
<body style="margin:0;padding:0;background:#efeae6;">

<div style="display:none;max-height:0;overflow:hidden;opacity:0;">{{ amount | money }} refunded{% if refund_gateway != '' %} to {{ refund_gateway }}{% endif %} — in your account by {{ land_by }}.</div>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#efeae6;">
<tr><td align="center" style="padding:28px 12px 44px;">

<table role="presentation" width="600" cellpadding="0" cellspacing="0" style="width:600px;max-width:100%;background:#ffffff;border-radius:16px;overflow:hidden;font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;">

  <tr><td style="padding:34px 40px 0;" align="center">
    <img src="https://petitemort.co/cdn/shop/files/PM_Logo1_Black_1.png" width="132" alt="{{ shop_name }}" style="display:block;border:0;width:132px;height:auto;">
  </td></tr>

  <tr><td style="padding:26px 40px 0;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
      <tr>
        <td style="font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#8a8a8a;">Order {{ order_name }}</td>
        <td align="right" style="font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#8a8a8a;">Refunded {{ 'now' | date: '%-d %B' }}</td>
      </tr>
    </table>
  </td></tr>

  <tr><td style="padding:30px 40px 0;">
    <h1 style="margin:0;font-size:30px;line-height:1.2;font-weight:600;color:#2c2d2e;letter-spacing:-.02em;">Your refund is on its way.</h1>
    <p style="margin:14px 0 0;font-size:15px;line-height:1.65;color:#57585a;">
      {% if buyer %}{{ buyer }}, we&rsquo;ve{% else %}We&rsquo;ve{% endif %} released it from our side. What happens next is
      your bank&rsquo;s timing, not ours &mdash; here is exactly what to look for and when.
    </p>
  </td></tr>

  <tr><td style="padding:26px 40px 0;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f6f2f0;border-radius:14px;">
      <tr><td style="padding:22px 24px;border-left:4px solid #b4b4b4;border-radius:14px;">
        <div style="font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#8a8a8a;font-weight:600;">Refunded</div>
        <div style="margin-top:7px;font-size:26px;font-weight:600;color:#b8543d;letter-spacing:-.01em;">{{ amount | money }}</div>
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-top:14px;">
          {%- if refund_gateway != '' -%}
          <tr>
            <td style="font-size:13px;color:#8a8a8a;padding-bottom:7px;">Back to</td>
            <td align="right" style="font-size:13px;font-weight:600;color:#2c2d2e;padding-bottom:7px;">{{ refund_gateway }}{% if refund_last4 != '' %} &nbsp;·&nbsp; &bull;&bull;&bull;&bull; {{ refund_last4 }}{% endif %}</td>
          </tr>
          {%- endif -%}
          <tr>
            <td style="font-size:13px;color:#8a8a8a;padding-bottom:7px;">Released by us</td>
            <td align="right" style="font-size:13px;font-weight:600;color:#2c2d2e;padding-bottom:7px;">{{ 'now' | date: '%-d %B %Y' }}</td>
          </tr>
          <tr>
            <td style="font-size:13px;color:#8a8a8a;">In your account by</td>
            <td align="right" style="font-size:13px;font-weight:600;color:#2c2d2e;">{{ land_by }}</td>
          </tr>
        </table>
        <div style="margin-top:14px;font-size:13px;line-height:1.6;color:#7c7c7c;">
          3&ndash;5 working days is your bank&rsquo;s processing window. Quote order {{ order_name }}
          if you ever need to ask them to trace it.
        </div>
      </td></tr>
    </table>
  </td></tr>

  <tr><td style="padding:30px 40px 0;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
      <tr>
        <td width="33.33%" align="center" style="padding-bottom:9px;"><div style="width:11px;height:11px;border-radius:50%;background:#b8543d;margin:0 auto;"></div></td>
        <td width="33.33%" align="center" style="padding-bottom:9px;"><div style="width:15px;height:15px;border-radius:50%;background:#b8543d;border:3px solid #f3d6cd;margin:0 auto;"></div></td>
        <td width="33.33%" align="center" style="padding-bottom:9px;"><div style="width:11px;height:11px;border-radius:50%;background:#e0d5d0;margin:0 auto;"></div></td>
      </tr>
      <tr><td colspan="3" style="padding:0 17%;"><div style="height:2px;background:#e8e0dc;font-size:0;line-height:0;">&nbsp;</div></td></tr>
      <tr>
        <td align="center" style="padding-top:11px;font-size:11.5px;color:#a3a3a3;">Approved</td>
        <td align="center" style="padding-top:11px;font-size:11.5px;font-weight:600;color:#b8543d;">With your bank</td>
        <td align="center" style="padding-top:11px;font-size:11.5px;color:#a3a3a3;">In your account</td>
      </tr>
    </table>
  </td></tr>

  {%- if refund_line_items.size > 0 -%}
  <tr><td style="padding:32px 40px 0;"><div style="height:1px;background:#ebe6e3;font-size:0;">&nbsp;</div></td></tr>

  <tr><td style="padding:26px 40px 0;">
    <div style="font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#8a8a8a;font-weight:600;">Refunded items</div>
  </td></tr>

  {%- for line in refund_line_items -%}
  <tr><td style="padding:18px 40px 0;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
      <tr>
        <td width="62" valign="top">
          {%- if line.line_item.image -%}
          <img src="{{ line.line_item | img_url: 'compact' }}" width="62" alt="{{ line.line_item.title | escape }}" style="display:block;border:1px solid #ede7e4;border-radius:10px;width:62px;height:auto;">
          {%- else -%}
          <div style="width:62px;height:62px;border-radius:10px;background:#f6f2f0;border:1px solid #ede7e4;"></div>
          {%- endif -%}
        </td>
        <td valign="top" style="padding-left:16px;">
          <div style="font-size:14.5px;font-weight:600;color:#2c2d2e;">{{ line.line_item.product.title | default: line.line_item.title }}</div>
          <div style="margin-top:3px;font-size:12.5px;color:#8a8a8a;">
            {%- if line.line_item.variant.title and line.line_item.variant.title != 'Default Title' -%}{{ line.line_item.variant.title }} &nbsp;·&nbsp; {%- endif -%}
            Qty {{ line.quantity }}
          </div>
        </td>
        <td align="right" valign="top" style="font-size:14.5px;font-weight:600;color:#2c2d2e;white-space:nowrap;">{{ line.subtotal | money }}</td>
      </tr>
    </table>
  </td></tr>
  {%- endfor -%}
  {%- endif -%}

  {%- if is_partial -%}
  <tr><td style="padding:24px 40px 0;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#faf7f5;border-radius:12px;">
      <tr><td style="padding:18px 20px;">
        <div style="font-size:13px;font-weight:600;color:#2c2d2e;">This is a partial refund</div>
        <div style="margin-top:6px;font-size:13px;line-height:1.6;color:#7c7c7c;">
          The rest of order {{ order_name }} is unaffected and still yours. Nothing else has
          been cancelled or charged.
        </div>
      </td></tr>
    </table>
  </td></tr>

  <tr><td style="padding:24px 40px 0;">
    <div style="height:1px;background:#ebe6e3;font-size:0;">&nbsp;</div>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-top:18px;">
      <tr><td style="font-size:13.5px;color:#6f6f6f;padding-bottom:9px;">Order total</td><td align="right" style="font-size:13.5px;color:#2c2d2e;padding-bottom:9px;">{{ total_price | money }}</td></tr>
      <tr><td style="font-size:13.5px;color:#6f6f6f;padding-bottom:9px;">Refunded now</td><td align="right" style="font-size:13.5px;color:#b8543d;padding-bottom:9px;">&minus; {{ amount | money }}</td></tr>
      <tr><td style="border-top:1px solid #ebe6e3;padding-top:14px;font-size:16px;font-weight:600;color:#2c2d2e;">Still paid</td><td align="right" style="border-top:1px solid #ebe6e3;padding-top:14px;font-size:16px;font-weight:600;color:#2c2d2e;">{{ still_paid | money }}</td></tr>
    </table>
  </td></tr>
  {%- endif -%}

  <tr><td style="padding:32px 40px 0;">
    <div style="height:1px;background:#ebe6e3;font-size:0;">&nbsp;</div>
    <div style="margin-top:24px;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#8a8a8a;font-weight:600;">Questions we usually get</div>

    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-top:16px;">
      <tr><td style="padding-bottom:15px;">
        <div style="font-size:13.5px;font-weight:600;color:#2c2d2e;">It&rsquo;s not in my account yet.</div>
        <div style="margin-top:4px;font-size:13px;line-height:1.6;color:#7c7c7c;">Wait the full five working days &mdash; banks post refunds in batches, and a refund often appears dated to the day you paid rather than today. If it&rsquo;s missing after {{ chase_after }}, reply and quote order {{ order_name }}.</div>
      </td></tr>
      <tr><td style="padding-bottom:15px;">
        <div style="font-size:13.5px;font-weight:600;color:#2c2d2e;">Why is the amount less than I paid?</div>
        <div style="margin-top:4px;font-size:13px;line-height:1.6;color:#7c7c7c;">Only the items listed above were refunded. If you expected the whole order back, reply &mdash; if we&rsquo;ve got it wrong we&rsquo;ll correct it the same working day.</div>
      </td></tr>
      <tr><td style="padding-bottom:15px;">
        <div style="font-size:13.5px;font-weight:600;color:#2c2d2e;">Can it go to a different card?</div>
        <div style="margin-top:4px;font-size:13px;line-height:1.6;color:#7c7c7c;">No. A refund can only travel back the way the payment came. That&rsquo;s a card-network rule, not our policy.</div>
      </td></tr>
      <tr><td>
        <div style="font-size:13.5px;font-weight:600;color:#2c2d2e;">My card was cancelled since I paid.</div>
        <div style="margin-top:4px;font-size:13px;line-height:1.6;color:#7c7c7c;">The refund still reaches you &mdash; your bank routes it to the replacement account. Allow up to ten working days, then reply and we&rsquo;ll trace it with you.</div>
      </td></tr>
    </table>
  </td></tr>

  <tr><td style="padding:26px 40px 0;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#2c2d2e;border-radius:14px;">
      <tr><td style="padding:24px 26px;">
        <div style="font-size:15px;font-weight:600;color:#ffffff;">Come to us first</div>
        <div style="margin-top:7px;font-size:13.5px;line-height:1.65;color:#b9bbbd;">
          If this refund looks wrong, reply to this email or write to
          <a href="mailto:info@petitemort.co" style="color:#f3d6cd;text-decoration:underline;">info@petitemort.co</a>.
          We can usually fix it the same working day &mdash; a card dispute takes your bank
          six to eight weeks to reach the same answer.
        </div>
      </td></tr>
    </table>
  </td></tr>

  <tr><td style="padding:30px 40px 38px;" align="center">
    <div style="font-size:12.5px;line-height:1.7;color:#9a9a9a;">
      <a href="{{ shop.url }}/policies/refund-policy" style="color:#7c7c7c;text-decoration:none;">Refunds</a> &nbsp;·&nbsp;
      <a href="{{ shop.url }}/policies/shipping-policy" style="color:#7c7c7c;text-decoration:none;">Shipping</a> &nbsp;·&nbsp;
      <a href="{{ shop.url }}/pages/contact" style="color:#7c7c7c;text-decoration:none;">Contact</a> &nbsp;·&nbsp;
      <a href="{{ shop.url }}" style="color:#7c7c7c;text-decoration:none;">Shop</a>
    </div>
    <div style="margin-top:16px;font-size:11.5px;line-height:1.7;color:#b4b4b4;">
      {{ shop_name }} &nbsp;·&nbsp; Instraat 13, 6021 AC Budel, Netherlands<br>
      This is a refund confirmation for order {{ order_name }}.
    </div>
  </td></tr>

</table>
</td></tr>
</table>
</body>
</html>
