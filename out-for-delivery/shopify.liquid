{%- comment -%}
  Petite Mort — OUT FOR DELIVERY
  Direction A (Warm Editorial). Settings → Notifications → Out for delivery.
  Fires on the carrier's out-for-delivery scan. Requires the carrier to report that
  status back through the fulfillment — QLS-brokered carriers do not all do this, so
  expect this one to fire on some markets and not others. See INSTALL-RUNBOOK.md.
{%- endcomment -%}

{%- assign buyer = customer.first_name | default: shipping_address.first_name -%}
{%- assign track_url = fulfillment.tracking_url | default: order_status_url -%}

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ shop.name }} — Order {{ order_name }} arrives today</title>
</head>
<body style="margin:0;padding:0;background:#efeae6;">

<div style="display:none;max-height:0;overflow:hidden;opacity:0;">Order {{ order_name }} is with the courier and arriving today. No signature needed.</div>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#efeae6;">
<tr><td align="center" style="padding:28px 12px 44px;">

<table role="presentation" width="600" cellpadding="0" cellspacing="0" style="width:600px;max-width:100%;background:#ffffff;border-radius:16px;overflow:hidden;font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;">

  <tr><td style="padding:34px 40px 0;" align="center">
    <img src="https://petitemort.co/cdn/shop/files/PM_Logo1_Black_1.png" width="132" alt="{{ shop.name }}" style="display:block;border:0;width:132px;height:auto;">
  </td></tr>

  <tr><td style="padding:26px 40px 0;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
      <tr>
        <td style="font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#8a8a8a;">Order {{ order_name }}</td>
        <td align="right" style="font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#8a8a8a;">Out for delivery</td>
      </tr>
    </table>
  </td></tr>

  <tr><td style="padding:30px 40px 0;">
    <h1 style="margin:0;font-size:30px;line-height:1.2;font-weight:600;color:#2c2d2e;letter-spacing:-.02em;">Arriving today.</h1>
    <p style="margin:14px 0 0;font-size:15px;line-height:1.65;color:#57585a;">
      {% if buyer %}{{ buyer }}, your{% else %}Your{% endif %} parcel is on the courier&rsquo;s van and out for delivery
      {% if shipping_address.city %}in {{ shipping_address.city }} {% endif %}right now.
    </p>
  </td></tr>

  <tr><td style="padding:26px 40px 0;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f3d6cd;border-radius:14px;">
      <tr><td style="padding:22px 24px;border-left:4px solid #b8543d;border-radius:14px;">
        <div style="font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#b8543d;font-weight:600;">Out for delivery</div>
        <div style="margin-top:7px;font-size:22px;font-weight:600;color:#2c2d2e;letter-spacing:-.01em;">Today, by end of day</div>
        <div style="margin-top:8px;font-size:13.5px;line-height:1.6;color:#7a5348;">
          {% if fulfillment.tracking_company %}{{ fulfillment.tracking_company }} doesn&rsquo;t{% else %}The carrier doesn&rsquo;t{% endif %}
          give a timed slot for this route. No signature is needed &mdash; if nobody answers,
          the courier leaves a card and holds the parcel nearby.
        </div>
      </td></tr>
    </table>
  </td></tr>

  <tr><td style="padding:30px 40px 0;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
      <tr>
        <td width="25%" align="center" style="padding-bottom:9px;"><div style="width:11px;height:11px;border-radius:50%;background:#b8543d;margin:0 auto;"></div></td>
        <td width="25%" align="center" style="padding-bottom:9px;"><div style="width:11px;height:11px;border-radius:50%;background:#b8543d;margin:0 auto;"></div></td>
        <td width="25%" align="center" style="padding-bottom:9px;"><div style="width:11px;height:11px;border-radius:50%;background:#b8543d;margin:0 auto;"></div></td>
        <td width="25%" align="center" style="padding-bottom:9px;"><div style="width:15px;height:15px;border-radius:50%;background:#ffffff;border:3px solid #b8543d;margin:0 auto;"></div></td>
      </tr>
      <tr><td colspan="4" style="padding:0 12%;"><div style="height:2px;background:#e8e0dc;font-size:0;line-height:0;">&nbsp;</div></td></tr>
      <tr>
        <td align="center" style="padding-top:11px;font-size:11.5px;color:#a3a3a3;">Confirmed</td>
        <td align="center" style="padding-top:11px;font-size:11.5px;color:#a3a3a3;">Packed</td>
        <td align="center" style="padding-top:11px;font-size:11.5px;color:#a3a3a3;">Shipped</td>
        <td align="center" style="padding-top:11px;font-size:11.5px;font-weight:600;color:#b8543d;">Arriving</td>
      </tr>
    </table>
  </td></tr>

  <tr><td style="padding:28px 40px 0;" align="center">
    <table role="presentation" cellpadding="0" cellspacing="0"><tr>
      <td style="background:#2c2d2e;border-radius:25px;">
        <a href="{{ track_url }}" style="display:inline-block;padding:15px 40px;font-size:14.5px;font-weight:600;color:#ffffff;text-decoration:none;letter-spacing:.01em;">Follow the van</a>
      </td>
    </tr></table>
    {%- if fulfillment.tracking_company or fulfillment.tracking_number -%}
    <div style="margin-top:13px;font-size:13px;color:#8a8a8a;">{{ fulfillment.tracking_company }}{% if fulfillment.tracking_company and fulfillment.tracking_number %} &nbsp;·&nbsp; {% endif %}{{ fulfillment.tracking_number }}</div>
    {%- endif -%}
  </td></tr>

  {%- if shipping_address -%}
  <tr><td style="padding:30px 40px 0;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#faf7f5;border-radius:12px;">
      <tr><td style="padding:18px 20px;">
        <div style="font-size:13px;font-weight:600;color:#2c2d2e;">Delivering to</div>
        <div style="margin-top:6px;font-size:13px;line-height:1.7;color:#7c7c7c;">
          {{ shipping_address.address1 }}{% if shipping_address.address2 != blank %}, {{ shipping_address.address2 }}{% endif %}, {{ shipping_address.zip }} {{ shipping_address.city }}<br>
          Wrong address, or need it left somewhere specific? Change it with the carrier
          using the tracking link above &mdash; they can still redirect today.
        </div>
      </td></tr>
    </table>
  </td></tr>
  {%- endif -%}

  <tr><td style="padding:32px 40px 0;">
    <div style="height:1px;background:#ebe6e3;font-size:0;">&nbsp;</div>
    <div style="margin-top:24px;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#8a8a8a;font-weight:600;">Questions we usually get</div>

    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-top:16px;">
      <tr><td style="padding-bottom:15px;">
        <div style="font-size:13.5px;font-weight:600;color:#2c2d2e;">I won&rsquo;t be home &mdash; what happens?</div>
        <div style="margin-top:4px;font-size:13px;line-height:1.6;color:#7c7c7c;">The courier leaves a card, then holds the parcel at a nearby pickup point for seven days. Nothing is lost and nothing is returned to us before then.</div>
      </td></tr>
      <tr><td style="padding-bottom:15px;">
        <div style="font-size:13.5px;font-weight:600;color:#2c2d2e;">Can a neighbour take it?</div>
        <div style="margin-top:4px;font-size:13px;line-height:1.6;color:#7c7c7c;">Yes, if you set that up on the carrier&rsquo;s tracking page before the courier arrives.</div>
      </td></tr>
      <tr><td>
        <div style="font-size:13.5px;font-weight:600;color:#2c2d2e;">It says delivered but I have nothing.</div>
        <div style="margin-top:4px;font-size:13px;line-height:1.6;color:#7c7c7c;">Check with anyone else at the address first, then reply to this email. We open a carrier investigation the same working day and you are never left out of pocket.</div>
      </td></tr>
    </table>
  </td></tr>

  <tr><td style="padding:26px 40px 0;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#2c2d2e;border-radius:14px;">
      <tr><td style="padding:24px 26px;">
        <div style="font-size:15px;font-weight:600;color:#ffffff;">Need us today?</div>
        <div style="margin-top:7px;font-size:13.5px;line-height:1.65;color:#b9bbbd;">
          Reply to this email or write to <a href="mailto:info@petitemort.co" style="color:#f3d6cd;text-decoration:underline;">info@petitemort.co</a>.<br>
          We answer within one working day, Monday to Friday.
        </div>
      </td></tr>
    </table>
  </td></tr>

  <tr><td style="padding:30px 40px 38px;" align="center">
    <div style="font-size:12.5px;line-height:1.7;color:#9a9a9a;">
      <a href="{{ shop.url }}/policies/shipping-policy" style="color:#7c7c7c;text-decoration:none;">Shipping</a> &nbsp;·&nbsp;
      <a href="{{ shop.url }}/policies/refund-policy" style="color:#7c7c7c;text-decoration:none;">Returns</a> &nbsp;·&nbsp;
      <a href="{{ shop.url }}/pages/contact" style="color:#7c7c7c;text-decoration:none;">Contact</a> &nbsp;·&nbsp;
      <a href="{{ track_url }}" style="color:#7c7c7c;text-decoration:none;">Track order</a>
    </div>
    <div style="margin-top:16px;font-size:11.5px;line-height:1.7;color:#b4b4b4;">
      {{ shop.name }} &nbsp;·&nbsp; Instraat 13, 6021 AC Budel, Netherlands<br>
      This is a delivery notice for order {{ order_name }}.
    </div>
  </td></tr>

</table>
</td></tr>
</table>
</body>
</html>
